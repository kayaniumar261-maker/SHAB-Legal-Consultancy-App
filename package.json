{
  "name": "shab-legal-consultancy-app",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/start-dev.mjs --start",
    "dev:check": "node ./scripts/start-dev.mjs --check",
    "dev:clean": "node ./scripts/start-dev.mjs --clean",
    "start": "npm run dev",
    "healthcheck": "node ./scripts/start-dev.mjs --health",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:codespace": "node ./scripts/start-dev.mjs --start",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.shab.legalconsultancy",
    "productName": "SHAB Legal Consultants FZC",
    "asar": true,
    "artifactName": "SHAB-Legal-Consultants-FZC-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SHAB Legal Consultants FZC"
    }
  },
  "description": "SHAB Legal Consultants FZC case, client and office management application.",
  "author": "SHAB Legal Consultants FZC"
}
